# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/*.log

# local uploads (development only)
/uploads

# production environment
.env.production
.env.production.local

# backup and test files
*.png
*.jpg
*.jpeg
*.bak
*.log
*.pid
test-*.html
test-*.js
*.session-notes.txt
FEATURE-*.md
BLOCKING-*.md
CRITICAL-*.md
ACTION-REQUIRED-*.md

# user uploads
public/uploads/

# autoforge artifacts
.autoforge/screenshots/
.autoforge/logs/
.autoforge/scratch/

# playwright artifacts
.playwright-mcp/*.png

# playwright e2e (test runner output + downloaded browsers cache)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# SQLite databases
*.db
*.sqlite
data/

# Claude Code local files
.claude/
