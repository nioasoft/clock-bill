# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/*.log

# local uploads (development only)
/uploads

# production environment
.env.production
.env.production.local

# backup and test files
*.png
*.jpg
*.jpeg
*.bak
*.log
*.pid
test-*.html
test-*.js
*.session-notes.txt
FEATURE-*.md
BLOCKING-*.md
CRITICAL-*.md
ACTION-REQUIRED-*.md

# user uploads
public/uploads/

# autoforge artifacts
.autoforge/screenshots/
.autoforge/logs/
.autoforge/scratch/

# playwright artifacts
.playwright-mcp/*.png

# playwright e2e (test runner output + downloaded browsers cache)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# SQLite databases
*.db
*.sqlite
data/

# Claude Code local files
.claude/

# Other agent tooling (local caches/plans — .mimocode is ~56MB)
.mimocode/

# Security audit reports — THIS REPO IS PUBLIC. These enumerate findings with
# file:line evidence and include local absolute paths; publishing them hands an
# attacker a map. Keep them local; share out-of-band.
docs/*security-audit*.html
docs/*security-review*.html

# Logo exploration artifacts from the rebrand. Unused by the app, and anything
# under public/ is served publicly — logo_data.json alone is ~2MB of base64.
public/logos/
scripts/generate_html.py
