# Production Environment Variables Template
# Copy this file to .env.production.local or set these in Vercel dashboard

# ==============================================
# DATABASE - Neon PostgreSQL (Required)
# ==============================================
# Get this from https://neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================
# AUTHENTICATION (Required)
# ==============================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long-here

# Your production deployment URL
BETTER_AUTH_URL=https://your-app.vercel.app

# ==============================================
# APP CONFIGURATION (Required)
# ==============================================
# Same as BETTER_AUTH_URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ==============================================
# FILE STORAGE - Vercel Blob (Required for file uploads in production)
# ==============================================
# IMPORTANT: You must enable Vercel Blob Storage for logo/signature uploads to work
#
# Steps to enable:
# 1. Go to your Vercel project dashboard
# 2. Navigate to the "Storage" tab
# 3. Create a new Blob store
# 4. Copy the "Read-Write Token" from the Blob store settings
# 5. Add the token below (format: vercel_blob_rw_xxxxxxxxxxxxx)
#
# Without this token, file uploads will fail in production
# In development, file uploads use local filesystem (public/uploads/)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# ==============================================
# OPTIONAL - Email Service
# ==============================================
# For password resets and email verification
# Get this from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ==============================================
# OPTIONAL - OAuth Providers
# ==============================================
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================
# OPTIONAL - Cloudflare R2 (Alternative to Vercel Blob)
# ==============================================
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
